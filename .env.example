# Server Configuration
PORT=4000
NODE_ENV=development
JWT_SECRET=smartot_super_secret_jwt_key_2026_production_safe
CORS_ORIGIN=http://localhost:5173

# Database (Default: Embedded SQLite in ./data/smartot.db.json)
DATABASE_PATH=./data/smartot.db.json

# AI Provider Configuration: local | grok | groq | openai | anthropic | gemini
# Default is 'local' (zero API keys required, works 100% offline)
AI_PROVIDER=local

# xAI Grok (Grok-2 / Grok-Beta)
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL_NAME=grok-2-latest

# Groq AI (Ultra-fast Llama-3 inference)
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# OpenAI Configuration
OPENAI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Operational Benchmark Thresholds (Minutes)
BENCHMARK_TRANSFER_MINUTES=15
BENCHMARK_TURNOVER_MINUTES=25
BENCHMARK_PREOP_BUFFER_MINUTES=30
