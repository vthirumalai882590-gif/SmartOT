  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs = require('fs'); fs.writeFileSync('dist/index.js', 'require(\\\"./backend/src/index.js\\\");');\"",
